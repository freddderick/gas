# Copy to /etc/pressure-alert/env and fill in. Never commit the real file.
DATABASE_PATH=/var/lib/pressure-alert/pressure.db

# Paid Open-Meteo Standard key. Blank = free endpoint (non-commercial,
# prototyping only; do not ship the App Store build against it).
OPEN_METEO_API_KEY=
OPEN_METEO_MONTHLY_BUDGET=1000000

# APNs token auth: Apple Developer > Certificates, IDs & Profiles > Keys.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_PATH=/etc/pressure-alert/AuthKey.p8
APNS_TOPIC=ca.andywood.PressureAlert

# Defaults, shown for reference.
# FETCH_INTERVAL_SECONDS=10800
# EVALUATE_INTERVAL_SECONDS=900
# STALE_AFTER_SECONDS=25200
# GRID_DEGREES=0.1
# FORECAST_DAYS=7
